#!/bin/sh

# Shared by CentOS 7 and AlmaLinux 9/10 hosts on the NFS home.
# Prefer capability detection because the same file runs on several releases.

umask 077

unset SESSION_MANAGER
unset DBUS_SESSION_BUS_ADDRESS
unset GNOME_KEYRING_CONTROL
unset GNOME_KEYRING_PID
unset GNOME_KEYRING_SOCKET
unset GNOME_DESKTOP_SESSION_ID

export XDG_SESSION_TYPE=x11
export GDK_BACKEND=x11
export QT_QPA_PLATFORM=xcb

# Older VNC sessions might not be started by systemd-logind and therefore lack
# XDG_RUNTIME_DIR. Provide a private, host-local fallback when necessary.
if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
    XDG_RUNTIME_DIR="/tmp/runtime-$(id -u)"
    mkdir -p "$XDG_RUNTIME_DIR"
    chmod 700 "$XDG_RUNTIME_DIR"
    export XDG_RUNTIME_DIR
fi

# Load locale settings used by old EL releases, then merge user X resources.
if [ -r /etc/locale.conf ]; then
    . /etc/locale.conf
elif [ -r /etc/sysconfig/i18n ]; then
    . /etc/sysconfig/i18n
fi

if [ -r "$HOME/.Xresources" ] && command -v xrdb >/dev/null 2>&1; then
    xrdb -merge "$HOME/.Xresources"
fi

# vncconfig provides clipboard integration on TigerVNC versions that need it.
if command -v vncconfig >/dev/null 2>&1; then
    vncconfig -nowin >/dev/null 2>&1 &
fi

run_desktop_session()
{
    if command -v dbus-run-session >/dev/null 2>&1; then
        exec dbus-run-session -- "$@"
    elif command -v dbus-launch >/dev/null 2>&1; then
        exec dbus-launch --exit-with-session "$@"
    else
        exec "$@"
    fi
}

# XFCE is the preferred VNC desktop.
if command -v startxfce4 >/dev/null 2>&1; then
    export DESKTOP_SESSION=xfce
    export XDG_SESSION_DESKTOP=xfce
    export XDG_CURRENT_DESKTOP=XFCE
    run_desktop_session startxfce4
fi

# Fall back to an installed GNOME X11 session.
if command -v gnome-session >/dev/null 2>&1; then
    export DESKTOP_SESSION=gnome
    export XDG_SESSION_DESKTOP=gnome
    export XDG_CURRENT_DESKTOP=GNOME

    if [ -r /usr/share/xsessions/gnome-classic.desktop ]; then
        run_desktop_session gnome-session --session=gnome-classic
    else
        run_desktop_session gnome-session
    fi
fi

# Let the distribution choose a session if neither preferred desktop launcher
# was found.
if [ -x /etc/X11/xinit/xinitrc ]; then
    exec /etc/X11/xinit/xinitrc
elif [ -r /etc/X11/xinit/xinitrc ]; then
    exec sh /etc/X11/xinit/xinitrc
fi

# Last-resort session: keep the VNC desktop usable for troubleshooting.
if command -v xterm >/dev/null 2>&1; then
    command -v xsetroot >/dev/null 2>&1 && xsetroot -solid "#eff1f5"
    exec xterm
fi

echo "No XFCE, GNOME, system X session, or xterm was found." >&2
exit 1
